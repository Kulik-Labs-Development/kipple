{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {},
    "test": {
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "PUBLIC_URL",
        "REDIS_URL",
        "MIGRATIONS_FOLDER",
        "SPA_ROOT",
        "PORT",
        "HOST"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URL",
        "AUTH_SECRET",
        "PUBLIC_URL",
        "REDIS_URL",
        "MIGRATIONS_FOLDER",
        "SPA_ROOT",
        "PORT",
        "HOST"
      ]
    }
  }
}
