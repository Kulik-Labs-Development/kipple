# Public address of the instance. Single source for email links, SSO
# redirects, webhooks, and MCP URLs.
PUBLIC_URL=http://localhost:3000

# Better Auth secret (32+ chars, high entropy). Generate with:
#   openssl rand -base64 32
# Also keys the at-rest encryption of instance settings credentials
# (SMTP/IMAP passwords, `enc1:` values in the settings table). Changing
# it makes stored credentials unrecoverable.
AUTH_SECRET=
# Set true when behind a reverse proxy that rewrites X-Forwarded-* headers
# (always true with the bundled Caddy `proxy` profile)
TRUST_PROXY=false

# Portainer: image tag to pull for api/worker (set per stack)
KIPPLE_TAG=latest

# Optional compose profiles to enable:
#   proxy = bundled Caddy reverse proxy with automatic HTTPS (Mode B)
#   dev   = mailpit (SMTP/IMAP capture) + adminer (DB browser)
# CLI:       docker compose --profile proxy up -d
# Portainer: set COMPOSE_PROFILES=proxy as a stack environment variable
#            (one value or * — comma lists are a known Portainer bug)
# COMPOSE_PROFILES=proxy

# Postgres (dev defaults — change in production)
POSTGRES_DB=kipple
POSTGRES_USER=kipple
POSTGRES_PASSWORD=kipple
DATABASE_URL=postgres://kipple:kipple@db:5432/kipple

# Redis
REDIS_URL=redis://redis:6379

# HTTP port inside the api container
PORT=3000

# --- Advanced overrides (working defaults exist; set only if needed) ---
# Host the API server binds to inside the container
HOST=0.0.0.0
# Where the built SPA lives (the API serves it at /). The Docker image
# stages it at /app/public and dev falls back to apps/web/dist.
# SPA_ROOT=
# Migrations folder override (default: apps/api/drizzle, found automatically)
# MIGRATIONS_FOLDER=
